# ---------------------------------------------------------------------------
# px-user-widgets playground
#
# Copy to `.env` and fill in. Everything without a default has to come from
# your mindtwo contact — see ../docs/oidc-external-app-integration.md §2 for
# the exact list to ask for.
# ---------------------------------------------------------------------------

# Seals the session cookie (nuxt-auth-utils). Minimum 32 characters.
NUXT_SESSION_PASSWORD=

# ---------------------------------------------------------------------------
# Public — these end up in the browser and on the widget attributes
# ---------------------------------------------------------------------------

# This app's own origin. Used for `data-app-url` (which resolves the widget
# stylesheet) and to build the redirect_uri as `${APP_URL}/callback`.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# `preprod` or `prod`. Selects the widget host script and the API hosts below.
NUXT_PUBLIC_PX_USER_STAGE=preprod

# Context identifiers, e.g. tenant=vnr, domain=px_teach
NUXT_PUBLIC_PX_USER_TENANT=
NUXT_PUBLIC_PX_USER_DOMAIN=

# OIDC client id, e.g. preprod-teachtoprotect-vnr-px-teach
#
# ⚠️  `http://localhost:3000/callback` must be registered as an EXACT-MATCH
#     redirect_uri for this client. An unregistered redirect_uri fails before
#     the login form even renders.
NUXT_PUBLIC_PX_USER_CLIENT_ID=

# Space separated. Must contain `openid`.
NUXT_PUBLIC_PX_USER_SCOPE=openid profile email

# Widget UI language (the widget's own default is `de`).
NUXT_PUBLIC_PX_USER_LANGUAGE=de

# Show the "login with Entra ID" button on the login widgets. On by default.
NUXT_PUBLIC_PX_USER_SHOW_EIP_LOGIN=true

# ---------------------------------------------------------------------------
# Server only — never bundled into the client
# ---------------------------------------------------------------------------

# Required for the code-for-token exchange. You are a confidential client.
NUXT_PX_USER_CLIENT_SECRET=

# Tenant path segment in front of the OIDC routes, e.g. plx:pxc
NUXT_PX_USER_CONTEXT=

# "Auth as a Service" mode only: the hosted login host we send the user to.
# Treat it as an opaque base URL — it may be a hosted login UI rather than the
# raw /authorize endpoint; the playground appends the standard parameters.
# Leave empty and that mode stays disabled on the index page.
NUXT_PX_USER_AUTHORIZATION_URL=

# Override the stage hosts if you need to point somewhere else.
# NUXT_PX_USER_OIDC_HOST=https://user-frontend.api.preprod.pl-x.cloud
# NUXT_PX_USER_API_HOST=https://user.api.preprod.pl-x.cloud
